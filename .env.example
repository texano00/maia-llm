# Telemetry backend configuration only.
# Provider credentials (Hugging Face, vast.ai, S3) are entered in the desktop
# app and stored in the operating-system credential vault, never in this file.

DATABASE_URL=postgres://maia:maia@localhost:5432/maia
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=maia-telemetry
TELEMETRY_HOST=127.0.0.1
TELEMETRY_PORT=8787
LOG_LEVEL=info

