# Telemetry backend configuration only.
# Provider credentials (Hugging Face, vast.ai, S3) are entered in the desktop
# app and stored in the operating-system credential vault, never in this file.

DATABASE_URL=postgres://maia:maia@localhost:5432/maia
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=maia-telemetry
TELEMETRY_HOST=127.0.0.1
TELEMETRY_PORT=8787
LOG_LEVEL=info

# Desktop development helpers (not used by the telemetry backend).
# MAIA_PROVIDER_MODE=mock
# MAIA_RELEASE_CHANNEL=stable
# MAIA_IDLE_TIMEOUT_MINUTES=10
# MAIA_UPDATE_CHECK_INTERVAL_HOURS=24
# MAIA_UPDATE_SIMULATE_VERSION=9.9.9
# MAIA_UPDATE_FEED_URL=https://example.com/maia-updates
# The diagnostics host is stored in Settings (default http://localhost:8787);
# this variable only overrides it at startup.
# MAIA_DIAGNOSTIC_LOG_URL=http://localhost:8787

# Portal auth (specs/002). Set a real secret in any shared deployment: access
# tokens are signed with it, so rotating it invalidates every issued token.
# MAIA_PORTAL_TOKEN_SECRET=change-me
# MAIA_PORTAL_ACCESS_TTL_MINUTES=60
# MAIA_PORTAL_REFRESH_TTL_DAYS=30
# MAIA_ADMIN_SESSION_HOURS=12
# Bootstrap administrator, seeded on first boot only.
# MAIA_ADMIN_EMAIL=admin@maiallm.com
# MAIA_ADMIN_PASSWORD=change-me-too
# Enforce installation credentials on ingestion routes. Leave false until the
# desktop release that enrolls itself ships, otherwise older clients lose
# their diagnostics.
# MAIA_REQUIRE_CLIENT_AUTH=true
