# Copy to infra/.env (never commit it) and fill in the secrets. Compose loads it
# twice: automatically for ${VARS} substitution in the compose file, and through
# `env_file:` for the processes.

# --- images --------------------------------------------------------------
# CI publishes both the root package.json version and `latest`.
MAIA_WEB_IMAGE=ghcr.io/texano00/maia-llm-web
MAIA_IMAGE=ghcr.io/texano00/maia-llm
MAIA_IMAGE_TAG=latest

# --- auto-update ---------------------------------------------------------
# Watchtower polls ghcr.io every N seconds (300 = 5 minutes, 900 = 15 minutes).
WATCHTOWER_POLL_INTERVAL=300

# --- TLS (compose profile "tls") -----------------------------------------
MAIA_DOMAIN=maiallm.com
TZ=UTC

# --- catalogue -----------------------------------------------------------
# Hugging Face service token; without it the snapshot cannot be refreshed.
MAIA_PORTAL_HF_TOKEN=
MAIA_CATALOGUE_REFRESH_HOURS=6
MAIA_CATALOGUE_LIMIT=300

# --- tokens and sessions -------------------------------------------------
MAIA_PORTAL_ACCESS_TTL_MINUTES=60
MAIA_PORTAL_REFRESH_TTL_DAYS=30
MAIA_ADMIN_SESSION_HOURS=12
# The backoffice administrator, seeded on first boot. The portal has no other
# way in: no sign-up, no email codes. Change the password by restarting with a
# new value against a fresh database until a password-change screen exists.
MAIA_ADMIN_EMAIL=admin@maiallm.com
MAIA_ADMIN_PASSWORD=change-me-too

# Keep false until every desktop client in the field enrolls itself; older
# builds post diagnostics without an installation token.
MAIA_REQUIRE_CLIENT_AUTH=false

# --- access (specs/005-web-access) ---------------------------------------
# Passwordless entry: one-time codes by email, a captcha, and per-account data.
# The server refuses to start in production when the first two are missing.
#
#   openssl rand -base64 48   -> MAIA_SESSION_SECRET
#   openssl rand -base64 32   -> MAIA_CREDENTIAL_KEY (32 bytes, AES-256-GCM)
#
# Losing MAIA_CREDENTIAL_KEY makes every stored provider credential
# undecryptable; rotating MAIA_SESSION_SECRET signs everybody out.
MAIA_SESSION_SECRET=
MAIA_CREDENTIAL_KEY=

# Cloudflare Turnstile. Site key is public; the secret key never leaves the server.
MAIA_TURNSTILE_SITE_KEY=
MAIA_TURNSTILE_SECRET_KEY=

# One transport is enough. Resend wins when both are set.
#   MAIA_MAIL_FROM="Maia LLM <access@maiallm.com>"
#   MAIA_RESEND_API_KEY=re_...
# or SMTP:
#   MAIA_SMTP_HOST=smtp.example.com
#   MAIA_SMTP_PORT=587
#   MAIA_SMTP_USER=
#   MAIA_SMTP_PASS=
MAIA_MAIL_FROM=Maia LLM <access@maiallm.com>
MAIA_RESEND_API_KEY=
MAIA_SMTP_HOST=
MAIA_SMTP_PORT=587
MAIA_SMTP_USER=
MAIA_SMTP_PASS=

# Source address for per-IP limits: Cloudflare is the only proxy in front of
# the container, so CF-Connecting-IP is trusted and X-Forwarded-For is ignored.
MAIA_TRUST_PROXY=cloudflare
MAIA_PUBLIC_ORIGIN=https://web.maiallm.com
MAIA_COOKIE_SECURE=true

# `live` rents GPUs with each account's own vast.ai key. `mock` needs no key.
MAIA_PROVIDER_MODE=live

# --- accounts view (specs/007) -------------------------------------------
# Internal API the Accounts tab uses to read accounts and change their
# capabilities. Unset = the routes do not exist at all, and that tab reports the
# product as unreachable; the rest of the backoffice keeps working.
MAIA_INTERNAL_TOKEN=
# Bootstrap: these addresses receive the `operator` capability on first sign-in.
MAIA_OPERATOR_EMAILS=
# Portal side: where the backoffice reaches the product.
MAIA_WEB_INTERNAL_URL=http://maia-web:5173

