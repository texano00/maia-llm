# Copy to infra/.env.production (never commit it) and fill in the secrets.
# Compose reads it twice: `--env-file` resolves ${VARS} in the compose file, and
# `env_file:` passes everything to the portal container.

# --- image ---------------------------------------------------------------
# CI publishes both the root package.json version and `latest`.
MAIA_IMAGE=ghcr.io/texano00/maia-llm
MAIA_IMAGE_TAG=latest

# --- auto-update ---------------------------------------------------------
# Watchtower polls ghcr.io every N seconds (300 = 5 minutes, 900 = 15 minutes).
WATCHTOWER_POLL_INTERVAL=300

# --- TLS (compose profile "tls") -----------------------------------------
MAIA_DOMAIN=maiallm.com
TZ=UTC

# --- catalogue -----------------------------------------------------------
# Hugging Face service token; without it the snapshot cannot be refreshed.
MAIA_PORTAL_HF_TOKEN=
MAIA_CATALOGUE_REFRESH_HOURS=6
MAIA_CATALOGUE_LIMIT=300

# --- tokens and sessions -------------------------------------------------
MAIA_PORTAL_ACCESS_TTL_MINUTES=60
MAIA_PORTAL_REFRESH_TTL_DAYS=30
MAIA_ADMIN_SESSION_HOURS=12

# Keep false until every desktop client in the field enrolls itself; older
# builds post diagnostics without an installation token.
MAIA_REQUIRE_CLIENT_AUTH=false
