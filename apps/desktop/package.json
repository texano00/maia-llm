{
  "name": "@maia/desktop",
  "version": "0.1.2",
  "private": true,
  "productName": "Maia LLM",
  "description": "Maia LLM desktop client",
  "author": {
    "name": "texano00"
  },
  "license": "UNLICENSED",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "npm run rebuild:native && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "rebuild:native": "electron-builder install-app-deps",
    "pack:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win dir --x64 --publish never",
    "dist:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --x64 --publish never",
    "dist:win:msi": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win msi --x64 --publish never"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.11",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "cross-env": "10.1.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "vite": "8.3.5"
  }
}
