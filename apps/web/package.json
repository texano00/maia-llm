{
  "name": "@maia/web",
  "version": "0.11.2",
  "private": true,
  "description": "Maia LLM web app and server",
  "author": {
    "name": "texano00"
  },
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && tsx src/web/server.ts",
    "build": "vite build && esbuild src/web/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=out/server.js --external:better-sqlite3 --external:nodemailer",
    "start": "tsx src/web/server.ts",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "nodemailer": "^7.0.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "0.28.2",
    "vite": "8.3.5"
  }
}
