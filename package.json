{
  "name": "maia-llm",
  "version": "0.11.5",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Account-free, privacy-first web app for running open-weight models on rented GPUs",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run -w @maia/web dev",
    "build": "npm run -w @maia/web build && npm run -w @maia/portal build",
    "lint": "eslint .",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/portal/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run --passWithNoTests apps/web/tests/contract apps/portal/tests/contract",
    "test:integration": "vitest run --passWithNoTests apps/web/tests/integration apps/portal/tests/integration",
    "test:telemetry-allowlist": "vitest run apps/portal/tests/contract/telemetry-allowlist.test.ts",
    "format": "prettier --write .",
    "assets:logo": "node scripts/generate-logo-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "globals": "16.4.0",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true
  }
}
