{
  "name": "maia-llm",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Desktop LLM suite with on-demand remote GPU and model archival",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run -w @maia/desktop dev",
    "build": "npm run -w @maia/desktop build && npm run -w @maia/telemetry-api build",
    "lint": "eslint .",
    "typecheck": "tsc -p apps/desktop/tsconfig.json --noEmit && tsc -p apps/telemetry-api/tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:preload": "node scripts/check-preload.mjs",
    "test:contract": "vitest run --passWithNoTests apps/desktop/tests/contract apps/telemetry-api/tests/contract",
    "test:integration": "vitest run --passWithNoTests apps/desktop/tests/integration apps/telemetry-api/tests/integration",
    "test:telemetry-allowlist": "vitest run apps/telemetry-api/tests/contract/telemetry-allowlist.test.ts",
    "release:verify": "tsx scripts/release/verify-version.ts",
    "format": "prettier --write .",
    "postinstall": "node ./node_modules/electron/install.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "globals": "16.4.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "better-sqlite3@13.0.3": true
  }
}
